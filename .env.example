# Local development defaults. Do not expose this initial status-only slice as a production app.
TEMPLUX_PROJECT_NAME=templux
TEMPLUX_HTTP_PORT=31000
TEMPLUX_API_PORT=31800
TEMPLUX_DB_PASSWORD=templux-local-only
# When changing the database password, set the matching full URL as well.
DATABASE_URL=postgresql://templux:templux-local-only@database:5432/templux
