# Local development defaults. Do not expose this initial status-only slice as a production app.
TEMPLUX_PROJECT_NAME=templux
TEMPLUX_HTTP_PORT=31000
TEMPLUX_API_PORT=31800
TEMPLUX_DB_PASSWORD=templux-local-only
# When changing the database password, set the matching full URL as well.
DATABASE_URL=postgresql://templux:templux-local-only@database:5432/templux

# Feishu long-lived credentials; runtime tokens are never supplied here.
APP_PUBLIC_URL=http://localhost:31000
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
# Optional canonical alias; if both are nonempty they must match.
FEISHU_ALLOWED_TENANT_KEY=
FEISHU_REDIRECT_URI=http://localhost:31000/api/auth/feishu/callback
PERSON_IDLE_TIMEOUT_SECONDS=600
PERSON_SESSION_MAX_SECONDS=43200

# Password/Agent policy is independent of Feishu credentials.
DEPLOYMENT_ENV=PROD
# Empty: DEV/UAT enabled; PROD disabled. Explicit true/false overrides.
AGENT_LOGIN_ENABLED=
AGENT_IDLE_TIMEOUT_SECONDS=600
AGENT_SESSION_MAX_SECONDS=43200
# Host directory mounted only into the controlled management container.
TEMPLUX_CREDENTIAL_DIR=./credentials
# Visible, online session polling; does not refresh idle activity (1–300 seconds).
HEARTBEAT_INTERVAL_SECONDS=30

# API accepts a stamped client IP only from these exact Web proxy hosts/IPs.
# Compose default is web; explicit empty is for a direct API deployment without Web forwarding.
PASSWORD_PROXY_HOSTS=web
# Keep empty unless an actual external TLS proxy is present. Use its precise IP/CIDR.
# The proxy must overwrite/append the real client IP; never trust arbitrary caller headers.
WEB_TRUSTED_PROXY_CIDRS=
