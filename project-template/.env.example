# Copy to .env; required/conditional nonblank values are validated before startup.
# Ubuntu domain deployment uses compose.traefik.yaml; local keeps loopback ports.
# @env TEMPLUX_PROJECT_NAME required public
TEMPLUX_PROJECT_NAME=project-app
# @env TEMPLUX_HTTP_PORT optional public
TEMPLUX_HTTP_PORT=31000
# @env TEMPLUX_API_PORT optional public
TEMPLUX_API_PORT=31800
# @env TEMPLUX_DB_PASSWORD localDatabase secret
TEMPLUX_DB_PASSWORD=templux-local-only
# When changing the database password, set the matching full URL as well.
# @env DATABASE_URL database secret
DATABASE_URL=postgresql://templux:templux-local-only@database:5432/templux

# Feishu long-lived credentials; runtime tokens are never supplied here.
# @env APP_PUBLIC_URL required public
APP_PUBLIC_URL=http://localhost:31000
# @env FEISHU_APP_ID feishu public
FEISHU_APP_ID=
# @env FEISHU_APP_SECRET feishu secret
FEISHU_APP_SECRET=
# @env FEISHU_TENANT_KEY optional public
FEISHU_TENANT_KEY=
# Optional canonical alias; if both are nonempty they must match.
# @env FEISHU_ALLOWED_TENANT_KEY optional public
FEISHU_ALLOWED_TENANT_KEY=
# @env FEISHU_REDIRECT_URI feishu public
FEISHU_REDIRECT_URI=
# @env PERSON_IDLE_TIMEOUT_SECONDS optional public
PERSON_IDLE_TIMEOUT_SECONDS=600
# @env PERSON_SESSION_MAX_SECONDS optional public
PERSON_SESSION_MAX_SECONDS=43200

# Password/Agent policy is independent of Feishu credentials.
# @env DEPLOYMENT_ENV required public
DEPLOYMENT_ENV=PROD
# Empty: DEV/UAT enabled; PROD disabled. Explicit true/false overrides.
# @env AGENT_LOGIN_ENABLED optional public
AGENT_LOGIN_ENABLED=
# @env AGENT_IDLE_TIMEOUT_SECONDS optional public
AGENT_IDLE_TIMEOUT_SECONDS=600
# @env AGENT_SESSION_MAX_SECONDS optional public
AGENT_SESSION_MAX_SECONDS=43200
# Host directory mounted only into the controlled management container.
# @env TEMPLUX_CREDENTIAL_DIR optional public
TEMPLUX_CREDENTIAL_DIR=./credentials
# Visible, online session polling; does not refresh idle activity (1–300 seconds).
# @env HEARTBEAT_INTERVAL_SECONDS optional public
HEARTBEAT_INTERVAL_SECONDS=30

# API accepts a stamped client IP only from these exact Web proxy hosts/IPs.
# Compose default is web; explicit empty is for a direct API deployment without Web forwarding.
# @env PASSWORD_PROXY_HOSTS optional public
PASSWORD_PROXY_HOSTS=web
# Entry receives public traffic. Trust only the precise upstream TLS proxy IP/CIDR.
# @env ENTRY_TRUSTED_PROXY_CIDRS domain public
ENTRY_TRUSTED_PROXY_CIDRS=
# Direct Web deployments may separately trust their explicit TLS proxy.
# The proxy must overwrite/append the real client IP; never trust arbitrary caller headers.
# @env WEB_TRUSTED_PROXY_CIDRS optional public
WEB_TRUSTED_PROXY_CIDRS=
# Audit retention: eligible after 90 days, bounded cleanup on service startup/hourly.
# @env AUDIT_RETENTION_DAYS configured public
AUDIT_RETENTION_DAYS=90
# @env AUDIT_CLEANUP_BATCH_SIZE configured public
AUDIT_CLEANUP_BATCH_SIZE=1000
# @env AUDIT_CLEANUP_MAX_BATCHES configured public
AUDIT_CLEANUP_MAX_BATCHES=10
# @env AUDIT_CLEANUP_INTERVAL_SECONDS configured public
AUDIT_CLEANUP_INTERVAL_SECONDS=3600
# Docker json-file budget per container; 14 days is a target, capacity can evict sooner.
# @env RUNTIME_LOG_MAX_BYTES configured public
RUNTIME_LOG_MAX_BYTES=10485760
# @env RUNTIME_LOG_MAX_FILES configured public
RUNTIME_LOG_MAX_FILES=10

# auto enables examples in DEV/UAT, disables in PROD; true/false override. Empty is invalid.
# @env COMPONENT_EXAMPLES_ENABLED configured public
COMPONENT_EXAMPLES_ENABLED=auto

# 数据库备份专用宿主目录（0700）；不与凭据/配置目录共用
# @env TEMPLUX_BACKUP_DIR optional public
TEMPLUX_BACKUP_DIR=./backups
# 仅迁移前成功自动备份，1–100；手动不自动清理
# @env TEMPLUX_BACKUP_RETAIN optional public
TEMPLUX_BACKUP_RETAIN=5

# local or traefik; DOMAIN_NAME is the optional ROOT domain. APP_HOST is the FULL hostname.
# @env TEMPLUX_ACCESS_MODE optional public
TEMPLUX_ACCESS_MODE=local
# @env DOMAIN_NAME optional public
DOMAIN_NAME=
# @env NETWORK_NAME domain public
NETWORK_NAME=

# @env APP_HOST domain public
APP_HOST=
