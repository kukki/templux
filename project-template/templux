#!/bin/sh
set -eu
TEMPLUX_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
templux_run() {
  TEMPLUX_RUN_STDERR=''
  if [ ! -t 1 ] && [ -t 2 ]; then TEMPLUX_RUN_STDERR="${TMPDIR:-/tmp}/templux-run.$$"; fi
  TEMPLUX_RUN_STATUS=0
  if [ -n "$TEMPLUX_RUN_STDERR" ]; then
    docker compose --project-directory "$TEMPLUX_ROOT" -f "$TEMPLUX_ROOT/compose.yaml" run --build --quiet-build --rm --no-deps "$@" 2>"$TEMPLUX_RUN_STDERR" || TEMPLUX_RUN_STATUS=$?
    cat "$TEMPLUX_RUN_STDERR" >&2
    rm -f "$TEMPLUX_RUN_STDERR"
  else
    docker compose --project-directory "$TEMPLUX_ROOT" -f "$TEMPLUX_ROOT/compose.yaml" run --build --quiet-build --rm --no-deps "$@" || TEMPLUX_RUN_STATUS=$?
  fi
  return "$TEMPLUX_RUN_STATUS"
}
# Explicit selection; never source/eval deployment .env in the host shell.
case "${1-}" in
  --help|help)
    echo 'Usage: ./templux [management-command] [options]'
    echo 'Environment: ./templux env-check|env-list [--json] (no database required)'
    echo 'Traefik mode: ./templux start --json (existing external network/TLS and domain .env values)'
    exit 0;;
  env-check|env-list)
    TEMPLUX_ENV_ACTION=check
    if [ "$1" = env-list ]; then TEMPLUX_ENV_ACTION=list; fi
    shift
    if [ ! -f "$TEMPLUX_ROOT/.env" ] || [ -L "$TEMPLUX_ROOT/.env" ] || [ ! -f "$TEMPLUX_ROOT/.env.example" ] || [ -L "$TEMPLUX_ROOT/.env.example" ]; then
      TEMPLUX_ENV_JSON=0
      for TEMPLUX_ENV_ARG in "$@"; do if [ "$TEMPLUX_ENV_ARG" = --json ]; then TEMPLUX_ENV_JSON=1; fi; done
      if [ "$TEMPLUX_ENV_JSON" = 1 ]; then echo '{"ok":false,"errors":[{"key":".env/.env.example","code":"missing_or_not_regular"}]}'; fi
      echo 'environment: require regular .env and .env.example files; existing values are never printed' >&2
      exit 1
    fi
    templux_run environment "$TEMPLUX_ENV_ACTION" "$@"; exit $?;;
esac

# Reject incomplete scripted restore before even probing/building a Docker image.
TEMPLUX_RESTORE_TARGET_KEY=''
if [ "${1-}" = restore ]; then
  TEMPLUX_RESTORE_MODE=''; TEMPLUX_RESTORE_TARGET=''; TEMPLUX_RESTORE_ARCHIVE=''; TEMPLUX_RESTORE_SHA=''
  TEMPLUX_RESTORE_CONFIRM=0; TEMPLUX_RESTORE_OVERWRITE=0; TEMPLUX_RESTORE_EXPECT=''; TEMPLUX_RESTORE_JSON=0
  TEMPLUX_RESTORE_VALID=1
  # Error formatting must not depend on whether an earlier option lacks its value.
  for TEMPLUX_RESTORE_ARG in "$@"; do
    if [ "$TEMPLUX_RESTORE_ARG" = --json ]; then TEMPLUX_RESTORE_JSON=1; fi
  done
  for TEMPLUX_RESTORE_ARG in "$@"; do
    if [ -n "$TEMPLUX_RESTORE_EXPECT" ]; then
      case "$TEMPLUX_RESTORE_ARG" in
        ''|--*) TEMPLUX_RESTORE_VALID=0;;
        *)
          case "$TEMPLUX_RESTORE_EXPECT" in
            mode) TEMPLUX_RESTORE_MODE=$TEMPLUX_RESTORE_ARG;; target) TEMPLUX_RESTORE_TARGET=$TEMPLUX_RESTORE_ARG;;
            archive) TEMPLUX_RESTORE_ARCHIVE=$TEMPLUX_RESTORE_ARG;; sha) TEMPLUX_RESTORE_SHA=$TEMPLUX_RESTORE_ARG;;
          esac
          TEMPLUX_RESTORE_EXPECT=''; continue;;
      esac
      TEMPLUX_RESTORE_EXPECT=''
    fi
    case "$TEMPLUX_RESTORE_ARG" in
      --mode) TEMPLUX_RESTORE_EXPECT=mode;; --target) TEMPLUX_RESTORE_EXPECT=target;;
      --archive) TEMPLUX_RESTORE_EXPECT=archive;; --sha256) TEMPLUX_RESTORE_EXPECT=sha;;
      --mode=*|--target=*|--archive=*|--sha256=*) TEMPLUX_RESTORE_VALID=0;;
      --confirm) TEMPLUX_RESTORE_CONFIRM=1;; --overwrite) TEMPLUX_RESTORE_OVERWRITE=1;; --json) TEMPLUX_RESTORE_JSON=1;;
    esac
  done
  case "$TEMPLUX_RESTORE_MODE" in original|independent) :;; *) TEMPLUX_RESTORE_VALID=0;; esac
  case "$TEMPLUX_RESTORE_TARGET" in current) :;; env:*)
    TEMPLUX_RESTORE_TARGET_KEY=${TEMPLUX_RESTORE_TARGET#env:}
    case "$TEMPLUX_RESTORE_TARGET_KEY" in ''|*[!A-Z0-9_]*|[0-9_]*) TEMPLUX_RESTORE_VALID=0;; esac;;
    *) TEMPLUX_RESTORE_VALID=0;; esac
  if [ -z "$TEMPLUX_RESTORE_ARCHIVE" ] || [ -z "$TEMPLUX_RESTORE_SHA" ] || [ "$TEMPLUX_RESTORE_CONFIRM" = 0 ] || [ "$TEMPLUX_RESTORE_OVERWRITE" = 0 ] || [ -n "$TEMPLUX_RESTORE_EXPECT" ]; then TEMPLUX_RESTORE_VALID=0; fi
  if [ "$TEMPLUX_RESTORE_VALID" = 0 ]; then
    if [ "$TEMPLUX_RESTORE_JSON" = 1 ]; then echo '{"ok":false,"error":"restore requires explicit --mode, --target, --archive, --sha256, --confirm and --overwrite before Docker; values must be separate arguments and cannot start with -- (archive example: /approved/--selected.dump)"}'; else echo 'restore requires explicit --mode, --target, --archive, --sha256, --confirm and --overwrite before Docker; values must be separate arguments and cannot start with -- (archive example: /approved/--selected.dump)' >&2; fi
    exit 1
  fi
fi
# Explicit paired container-owner override for independently verified bind-mount mappings.
if [ "${TEMPLUX_HOST_UID+x}" != "${TEMPLUX_HOST_GID+x}" ]; then
  echo 'TEMPLUX_HOST_UID/GID 必须成对提供。' >&2; exit 1
fi
for TEMPLUX_OWNER_VALUE in "${TEMPLUX_HOST_UID-$(id -u)}" "${TEMPLUX_HOST_GID-$(id -g)}"; do
  case "$TEMPLUX_OWNER_VALUE" in ''|*[!0-9]*|0[0-9]*) echo '宿主属主覆盖必须为规范非负整数。' >&2; exit 1;; esac
  if [ "${#TEMPLUX_OWNER_VALUE}" -gt 10 ] || [ "$TEMPLUX_OWNER_VALUE" -gt 4294967294 ]; then
    echo '宿主属主覆盖超出UID/GID范围。' >&2; exit 1
  fi
done
TEMPLUX_AUTH_AVAILABILITY=$(templux_run auth-config-probe) || TEMPLUX_AUTH_AVAILABILITY=''
if [ -n "$TEMPLUX_RESTORE_TARGET_KEY" ]; then set -- -e "$TEMPLUX_RESTORE_TARGET_KEY" management "$@"; else set -- management "$@"; fi
if [ "${TEMPLUX_RESTORE_ADMIN_URL+x}" = x ]; then set -- -e TEMPLUX_RESTORE_ADMIN_URL "$@"; fi
templux_run \
  -e "TEMPLUX_AUTH_AVAILABILITY_JSON=$TEMPLUX_AUTH_AVAILABILITY" \
  -e "TEMPLUX_PROJECT_DIR=$TEMPLUX_ROOT" \
  -e "TEMPLUX_HOST_UID=${TEMPLUX_HOST_UID-$(id -u)}" -e "TEMPLUX_HOST_GID=${TEMPLUX_HOST_GID-$(id -g)}" \
  -v "$TEMPLUX_ROOT:$TEMPLUX_ROOT:ro" \
  "$@"
